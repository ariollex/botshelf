# Public domain that already points to the server by A/AAAA record.
DOMAIN=botshelf.example.ru
# Use a random hexadecimal string, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
# Token of the MAX bot that hosts this mini-app. Never commit a real token.
MAX_BOT_TOKEN=replace-with-token-from-max
# Comma-separated numeric MAX user IDs allowed to moderate, for example 123,456.
MODERATOR_MAX_USER_IDS=123456789
